# Copy to .env. In production (TWIN_ENV=production) the two secrets MUST be set.
TWIN_ENV=development
DATABASE_URL=sqlite:///./data/twin.db
# DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/twin
SECRET_KEY=change-me
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=
CORS_ORIGINS=http://localhost:5173
SEED_DEMO=true
